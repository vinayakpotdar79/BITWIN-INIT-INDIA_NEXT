PORT=3000
FRONTEND_URL=http://localhost:5173
SERVER_URL=http://localhost:3000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Gmail Push Notifications (Pub/Sub)
# Required for real-time email updates via webhooks
GMAIL_PUBSUB_TOPIC=projects/alien-slice-490409-e7/topics/gmail-notifications

# Webhook URL - explicitly set for production deployments
# For development, defaults to http://localhost:3000/gmail/webhook
# GMAIL_WEBHOOK_URL=https://your-production-domain.com/gmail/webhook

# Google Cloud Service Account (optional, for production Pub/Sub auth)
# Download JSON key from Google Cloud Console and point to it
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# AI/ML Services
GROQ_API_KEY=your-groq-api-key-here
